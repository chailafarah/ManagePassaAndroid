<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SignInActivity" android:background="@color/white">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textView3"
            style="@style/largebold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_page_title" />

        <TextView
            android:id="@+id/textView4"
            style="@style/xs_medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_page_sous_title" />

        <TextView
            android:id="@+id/textView5"
            style="@style/xs_medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_page_label_email" />
        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Loisbecket@gmail.com" android:textColorHint="@color/neutral" android:background="@drawable/edit_text_border" android:padding="12dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>