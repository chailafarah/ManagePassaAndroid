<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ManagePass" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.ManagePass" parent="Base.Theme.ManagePass" />
    <style name="lexend_regular">
        <item name="android:fontFamily">@font/lexendregular</item>
    </style>
    <style name="lexend_medium">
        <item name="android:fontFamily">@font/lexendmedium</item>
    </style>
    <style name="lexend_semibold">
        <item name="android:fontFamily">@font/lexendsemibold</item>
    </style>
    <style name="lexend_bold">
        <item name="android:fontFamily">@font/lexendbold</item>
    </style>
    <style name="xs_regular" parent="lexend_regular">
        <item name="android:textColor">@color/gris_ardoise</item>
        <item name="android:textSize">8dp</item>
    </style>
    <style name="xs_medium" parent="lexend_medium">
        <item name="android:textColor">@color/gris_ardoise</item>
        <item name="android:textSize">8dp</item>
    </style>
    <style name="xs_Semibold" parent="lexend_semibold">
        <item name="android:textSize">8dp</item>
    </style>
    <style name="s_regular" parent="lexend_medium">
        <item name="android:textColor">@color/gris_ardoise</item>
        <item name="android:textSize">10dp</item>
    </style>
    <style name="s_semibold_white" parent="lexend_semibold">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">10dp</item>
    </style>
    <style name="s_semibold_neutral" parent="lexend_semibold">
        <item name="android:textColor">@color/neutral</item>
        <item name="android:textSize">10dp</item>
    </style>
    <style name="s_medium" parent="lexend_medium">
        <item name="android:textColor">@color/neutral</item>
        <item name="android:textSize">10dp</item>
    </style>
    <style name="mediumlarge" parent="lexend_medium" >
        <item name="android:textColor">@color/neutral</item>
        <item name="android:textSize">16dp</item>
    </style>
    <style name="largebold" parent="lexend_bold">
        <item name="android:textColor">@color/neutral</item>
        <item name="android:textSize">24dp</item>
    </style>
</resources>